{
  "manifest_version": 3,
  "name": "Manga Russian OCR",
  "version": "0.1.0",
  "permissions": ["activeTab"],
  "host_permissions": [
    "<all_urls>",
    "https://*.mixlib.me/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["tesseract.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}